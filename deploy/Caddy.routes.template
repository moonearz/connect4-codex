# Import inside the existing site block, replacing its app routes.
# Keep your existing TLS, logging, and other site settings.
redir /wordle /wordle/ 308
redir /connect4 /connect4/ 308
redir /tictactoe /tictactoe/ 308

handle_path /wordle/* {
    reverse_proxy 127.0.0.1:{{WORDLE_PORT}} {
        header_up X-Forwarded-Prefix /wordle
    }
}
handle_path /connect4/* {
    reverse_proxy 127.0.0.1:{{CONNECT4_PORT}} {
        header_up X-Forwarded-Prefix /connect4
    }
}
# Tic-tac-toe already defines /tictactoe/<id> paths: do NOT strip this prefix.
handle /tictactoe/* {
    @launch path /tictactoe/
    rewrite @launch /
    reverse_proxy 127.0.0.1:{{TICTACTOE_PORT}} {
        # The existing app redirects expired games to /; relaunch the game here.
        header_down Location ^/$ /tictactoe/
    }
}
handle {
    root * {{WEB_ROOT}}
    file_server
}
